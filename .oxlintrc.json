{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/exhaustive-deps": "warn",
    "react/rules-of-hooks": "deny"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist/"]
}
